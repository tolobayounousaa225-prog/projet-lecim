# Copier ce fichier en .env puis adapter les valeurs.
DATABASE_URL=postgresql+psycopg2://psie:psie@localhost:5432/psie
SECRET_KEY=changez-cette-cle-en-production
# true en production (HTTPS) : le cookie de session n'est alors envoye que sur HTTPS
COOKIE_SECURE=false
DEBUG=false

# URL publique de l'application (encodee dans les QR codes des recus et attestations)
PUBLIC_BASE_URL=http://localhost:8100

# Double authentification par e-mail pour l'administrateur et le secretaire aux finances.
# Mettre true en production (necessite le SMTP ci-dessous) ; false possible en developpement local.
TWO_FACTOR_ENABLED=false

# Serveur SMTP (code de connexion, relances, resume hebdomadaire)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@psie.local

# Adresse prevenue a chaque nouvelle demande d'adhesion (facultatif)
NOTIFY_EMAIL=

# Taches planifiees : creation des cotisations de l'annee, relances, resume du lundi
SCHEDULER_ENABLED=true

ADMIN_BOOTSTRAP_EMAIL=admin@psie.local
ADMIN_BOOTSTRAP_PASSWORD=change-moi-123
ADMIN_BOOTSTRAP_NAME=Administrateur PSIE
