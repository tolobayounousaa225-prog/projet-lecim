# Copier ce fichier en .env (chmod 600) puis remplacer TOUTES les valeurs « CHANGER ».
# Ne jamais commiter le fichier .env.

# --- Base de données ---
POSTGRES_USER=psie
POSTGRES_DB=psie
POSTGRES_PASSWORD=CHANGER-mot-de-passe-long-et-unique

# --- Application ---
# Générer avec :  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGER
# true = mode production : l'application refuse de démarrer si la configuration est dangereuse
COOKIE_SECURE=true
DEBUG=false
TWO_FACTOR_ENABLED=true
SCHEDULER_ENABLED=true
PUBLIC_BASE_URL=https://CHANGER-votre-domaine
# Domaine servi par Caddy (profil « caddy » seulement)
DOMAIN=CHANGER-votre-domaine
# Port local d'écoute (le reverse proxy y est branché)
PSIE_PORT=8100

# --- Premier compte administrateur (utilisé une seule fois par init_db) ---
ADMIN_BOOTSTRAP_EMAIL=CHANGER@exemple.org
ADMIN_BOOTSTRAP_PASSWORD=CHANGER-mot-de-passe-long
ADMIN_BOOTSTRAP_NAME=Administrateur PSIE

# --- E-mail (obligatoire : code de double authentification, relances, convocations) ---
SMTP_HOST=CHANGER
SMTP_PORT=587
SMTP_USER=CHANGER
SMTP_PASSWORD=CHANGER
SMTP_FROM=no-reply@CHANGER-votre-domaine
# Adresse prévenue à chaque demande d'adhésion (facultatif)
NOTIFY_EMAIL=

# --- Sauvegardes (utilisées par backup.sh) ---
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
# Fichier contenant la phrase secrète de chiffrement (voir DEPLOIEMENT.md)
BACKUP_PASSFILE=./backup.pass
