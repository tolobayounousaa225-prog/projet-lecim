# Copiez ce fichier en ".env" et adaptez les valeurs.

# Base de données PostgreSQL
# En local avec Docker : postgresql+psycopg2://lecim:lecim@db:5432/lecim
# Avec Supabase : utilisez le "Session pooler" (Project Settings > Database > Connect),
# pas la "Direct connection" (IPv6 uniquement, souvent injoignable) :
# postgresql+psycopg2://postgres.<ref-projet>:<mot-de-passe>@aws-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg2://lecim:lecim@db:5432/lecim

# Sécurité JWT — générez une vraie valeur aléatoire en production
# (ex: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=changez-cette-cle-en-production
ACCESS_TOKEN_EXPIRE_MINUTES=180

# Origines autorisées à appeler l'API depuis le navigateur (site vitrine)
# Séparées par des virgules
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000

# Compte administrateur créé automatiquement au premier démarrage
ADMIN_BOOTSTRAP_EMAIL=admin@lecim.org
ADMIN_BOOTSTRAP_PASSWORD=change-moi-123
ADMIN_BOOTSTRAP_NAME=Administrateur LECIM

# Envoi d'e-mail optionnel pour notifier les nouveaux messages de contact
# Laissez vide pour désactiver l'envoi d'e-mails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@lecim.org
CONTACT_NOTIFY_EMAIL=lecimnational@gmail.com

# URL publique de ce backend (utilisée dans le QR code des cartes de membres
# pour pointer vers la page de vérification) — remplacez par le vrai domaine en production
PUBLIC_BASE_URL=http://localhost:8000
